{
  "manifest_version": 3,
  "name": "YTGrab",
  "version": "1.0.0",
  "description": "Send YouTube videos to the YTGrab app with one click.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Send this video to YTGrab",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus"],
  "host_permissions": ["http://127.0.0.1:47681/*"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["icons/32.png"],
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"]
  }]
}
